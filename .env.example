# 配置模板：复制为 .env 后，在本地填写自己的密钥。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 模型名称和接口地址可以在这里调整，不需要修改 Python 代码。
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：Langfuse 追踪。两项都填写后才会发送 Agent 调用链；留空则完全禁用。
# 追踪会包含发送给模型的资料、问题、工具调用与模型输出，请按数据处理要求配置。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 云端 EU 区域默认：https://cloud.langfuse.com；自托管或其他区域时改为对应 HTTPS 地址。
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 可选，用于在控制台区分环境，例如 development、production。
LANGFUSE_TRACING_ENVIRONMENT=development
